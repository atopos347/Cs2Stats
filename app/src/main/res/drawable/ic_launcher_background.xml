<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标背景：品牌藏蓝斜向渐变（左上 #1C3A66 → 右下 #0A111D）。
  用 drawable 而不是纯色：图标边缘带一点光比，压在任何壁纸上都立得住。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#1C3A66"
        android:endColor="#0A111D" />
</shape>
